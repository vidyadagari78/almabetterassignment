PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/almabetter_evaluations
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/almabetter_evaluations

# Distributed Cache & Queue (Amazon ElastiCache / Redis)
REDIS_URL=redis://localhost:6379

# Object Storage (Amazon S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_SUBMISSION_BUCKET=almabetter-submissions-prod

# AI / LLM Providers (Managed via LiteLLM)
ANTHROPIC_API_KEY=your-anthropic-claude-api-key
OPENAI_API_KEY=your-openai-api-key
LITELLM_GATEWAY_URL=http://localhost:4000

# Security Tokens & JWT
JWT_SECRET=super-secret-jwt-signing-key-for-almabetter-2026
